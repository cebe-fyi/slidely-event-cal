# This sample-data prototype builds without environment variables.
# Add these when we implement Supabase. Never commit actual secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Gemini integration is a later milestone.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: override public raster tiles. Default uses OpenStreetMap without a key.
# Update attribution in src/features/map/config.ts when changing providers.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
